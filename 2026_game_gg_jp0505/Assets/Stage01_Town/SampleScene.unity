--- !u!114 &1137974355
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1137974354}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54a7b04d89efaf6478bab9c213f5c841, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uCD0C\uC7A5"
    text: "\uBC18\uAC11\uAD6C\uB098 "
  - speaker: "\uB098"
    text: "\uB124 \uBC18\uAC11\uC2B5\uB2C8\uB2E4"
  - speaker: "\uCD0C\uC7A5"
    text: "\uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uC628\uAC78 \uD658\uC601\uD558\uB124 "
  - speaker: "\uB098"
    text: "\uB124 \uD658\uC601\uD574\uC8FC\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4 \n"
  - speaker: "\uCD0C\uC7A5"
    text: "\uC74C....."
  - speaker: "\uB098"
    text: "\uBB34\uC2A8 \uACE0\uBBFC \uC788\uC73C\uC138\uC694?\n"
  - speaker: "\uCD0C\uC7A5"
    text: "\uADF8\uAC8C \uB0B4\uAC00.. \uC5F4\uC1E0\uB97C \uC783\uC5B4\uBC84\uB824\uC11C
      \uB0B4 \uC548\uC88B\uC740 \uC2DC\uB825\uC73C\uB860.. \uCC3E\uC744\uC218 \uC5C6\uB124.."
  - speaker: "\uB098"
    text: "\uADF8\uB807\uAD70\uC694 \uADF8\uB7FC \uC81C\uAC00 \uCC3E\uC544\uB4DC\uB9B4\uAC8C\uC694!\n"
  - speaker: "\uCD0C\uC7A5"
    text: "\uC815\uB9D0?? \uC815\uB9D0\uB85C \uCC3E\uC544\uC904\uAC90\uAC00? "
  - speaker: "\uB098"
    text: "\uB124 \uADF8\uB7FC\uC694"
  - speaker: "\uCD0C\uC7A5"
    text: "\uC5F4\uC1E0\uB294 \uBD81\uCABD \uC232\uC5D0 \uC788\uB2E4\uB124 \uC870\uC2EC\uD558\uC5EC\uC57C
      \uD55C\uB2E4"
  - speaker: "\uB098"
    text: "\uB124! \uADF8\uB7FC \uAC14\uB2E4 \uC624\uACA0\uC2B5\uB2C8\uB2E4"
  - speaker: "\uCD0C\uC7A5"
    text: "\uADF8\uB798 \uBD80\uD0C1\uD558\uB124!! \uC870\uC2EC\uD788 \uB2E4\uB140\uC640!\n"
  choice1: "\uC5F4\uC1E0\uB97C \uCC3E\uB294\uB2E4"
  choice2: "\uCC3E\uC9C0 \uC54A\uB294\uB2E4"
  onChoice1:
    m_PersistentCalls:
      m_Calls: []
  onChoice2:
    m_PersistentCalls:
      m_Calls: []
  prompt: {fileID: 2108400522}
  dialogueBox: {fileID: 1953066148}
